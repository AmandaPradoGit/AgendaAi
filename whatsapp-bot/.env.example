# URL do endpoint Laravel para recepção de pedidos
# Padrão: http://localhost:8000/api/whatsapp/webhook
LARAVEL_ENDPOINT=http://localhost:8000/api/whatsapp/webhook

# Configuração do Bot (opcional)
# Tempo de reconexão em milissegundos (padrão: 5000 = 5 segundos)
# RECONNECT_DELAY=5000

# Gatilhos para identificação de pedidos (separados por vírgula)
# Padrão: 🎂✅,/confirmar,/pedido
# TRIGGERS=🎂✅,/confirmar,/pedido
